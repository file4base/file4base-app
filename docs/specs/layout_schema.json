{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "File4BaseLayoutSchema",
  "description": "Deterministic JSON layout schema defining view structure, parts, and objects for File4Base Flutter renderer.",
  "type": "object",
  "required": ["id", "name", "table_occurrence", "width", "theme", "default_view", "parts", "objects"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier of the layout."
    },
    "name": {
      "type": "string",
      "description": "User-friendly name of the layout."
    },
    "table_occurrence": {
      "type": "string",
      "description": "The base Table Occurrence (TO) in the relationship graph context."
    },
    "width": {
      "type": "number",
      "description": "Fixed canvas design width in logical pixels."
    },
    "theme": {
      "type": "string",
      "description": "The layout's theme: how a generated layout looks (#33). Not the application theme in Manage Themes, which colours the window.",
      "enum": ["Enlightened", "Cool Grey", "Classic", "Minimal"],
      "default": "Enlightened"
    },
    "label_stock": {
      "type": "object",
      "description": "Present only on a labels layout, which is one label repeated across and down a sheet (#33).",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "page_width_mm": { "type": "number" },
        "page_height_mm": { "type": "number" },
        "label_width_mm": { "type": "number" },
        "label_height_mm": { "type": "number" },
        "across": { "type": "integer" },
        "down": { "type": "integer" },
        "margin_left_mm": { "type": "number" },
        "margin_top_mm": { "type": "number" },
        "gutter_x_mm": { "type": "number" },
        "gutter_y_mm": { "type": "number" }
      }
    },
    "default_view": {
      "type": "string",
      "enum": ["form", "list", "table"],
      "default": "form"
    },
    "background_color": {
      "type": "string",
      "description": "Layout background as #RRGGBB. Absent = white."
    },
    "background_image": {
      "type": "object",
      "description": "Picture drawn behind every object of the layout. Stored inline as base64 (max 2 MB) or referenced by URL.",
      "required": ["kind", "name"],
      "properties": {
        "kind": { "type": "string", "enum": ["image"] },
        "name": { "type": "string" },
        "mime_type": { "type": "string" },
        "data": { "type": "string", "contentEncoding": "base64" },
        "url": { "type": "string" },
        "fit": { "type": "string", "enum": ["cover", "contain", "fill", "tile"], "default": "cover" }
      }
    },
    "on_layout_enter": {
      "type": "object",
      "description": "Script trigger run in Browse mode when the layout is shown. Same shape as a button action with type perform_script.",
      "properties": {
        "type": { "type": "string", "enum": ["perform_script"] },
        "script_id": { "type": "string" },
        "script_name": { "type": "string" },
        "parameter": { "type": "string" }
      }
    },
    "on_layout_exit": {
      "type": "object",
      "description": "Script trigger run in Browse mode when another layout replaces this one. Same shape as on_layout_enter.",
      "properties": {
        "type": { "type": "string", "enum": ["perform_script"] },
        "script_id": { "type": "string" },
        "script_name": { "type": "string" },
        "parameter": { "type": "string" }
      }
    },
    "transition": {
      "type": "string",
      "description": "Effect played when the layout is shown in Browse mode.",
      "enum": ["none", "fade", "slide_left", "slide_up", "zoom"],
      "default": "none"
    },
    "parts": {
      "type": "array",
      "description": "List of structural layout parts dividing the canvas vertically. The layout height is the sum of the part heights: the layout ends at the bottom of the footer.",
      "items": {
        "type": "object",
        "required": ["id", "type", "height"],
        "properties": {
          "id": { "type": "string" },
          "type": {
            "type": "string",
            "enum": [
              "top_navigation",
              "title_header",
              "header",
              "leading_grand_summary",
              "body",
              "subsummary",
              "trailing_grand_summary",
              "footer",
              "bottom_navigation"
            ]
          },
          "height": { "type": "number" },
          "break_field": {
            "type": "string",
            "description": "Field identifier used for grouping if part is subsummary."
          }
        }
      }
    },
    "objects": {
      "type": "array",
      "description": "UI elements placed on the layout canvas.",
      "items": {
        "$ref": "#/definitions/LayoutObject"
      }
    }
  },
  "definitions": {
    "LayoutObject": {
      "type": "object",
      "required": ["id", "type", "x", "y", "width", "height"],
      "properties": {
        "id": { "type": "string" },
        "type": {
          "type": "string",
          "enum": [
            "field",
            "label",
            "button",
            "button_bar",
            "portal",
            "tab_control",
            "slide_control",
            "popover_button",
            "chart",
            "web_viewer",
            "rect",
            "rounded_rect",
            "oval",
            "line",
            "media"
          ]
        },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number" },
        "height": { "type": "number" },
        "text": {
          "type": "string",
          "description": "Text of labels, buttons and drawn shapes. Merge symbols {{field_name}}, {{CurrentDate}}, {{CurrentTime}}, {{CurrentUser}} and {{PageNumber}} are resolved in Browse and Preview modes."
        },
        "name": { "type": "string" },
        "tooltip": { "type": "string" },
        "is_locked": { "type": "boolean" },
        "tab_order": {
          "type": "integer",
          "minimum": 1,
          "description": "Position of a field or button in the Tab key sequence. Objects without it follow the numbered ones in reading order (top to bottom, left to right)."
        },
        "action": {
          "type": "object",
          "description": "What a button runs when clicked in Browse mode.",
          "required": ["type"],
          "properties": {
            "type": { "type": "string", "enum": ["single_step", "perform_script"] },
            "step_type": {
              "type": "string",
              "description": "single_step: new_record, duplicate_record, delete_record, commit_records, revert_record, go_to_record, enter_find_mode, perform_find, show_all_records, enter_preview_mode, go_to_layout, set_field, show_dialog, open_url."
            },
            "params": {
              "type": "object",
              "description": "Step parameters, named as in the Script Workspace: target, layout_name, field, value, title, message, url."
            },
            "script_id": { "type": "string" },
            "script_name": { "type": "string" },
            "parameter": { "type": "string" }
          }
        },
        "media": {
          "type": "object",
          "description": "Picture, PDF, audio/video or file shown inside a shape (rect, rounded_rect, oval) or a media object. Stored inline as base64 (max 2 MB) or referenced by URL.",
          "required": ["kind", "name"],
          "properties": {
            "kind": { "type": "string", "enum": ["image", "pdf", "video", "audio", "file"] },
            "name": { "type": "string" },
            "mime_type": { "type": "string" },
            "data": { "type": "string", "contentEncoding": "base64" },
            "url": { "type": "string" },
            "fit": { "type": "string", "enum": ["contain", "cover", "fill"] }
          }
        },
        "anchors": {
          "type": "object",
          "properties": {
            "top": { "type": "boolean", "default": true },
            "bottom": { "type": "boolean", "default": false },
            "left": { "type": "boolean", "default": true },
            "right": { "type": "boolean", "default": false }
          }
        },
        "field_binding": {
          "type": "object",
          "properties": {
            "table_occurrence": {
              "type": "string",
              "description": "Occurrence the field is read from. Another occurrence makes this a related field, read through relationship_id (#36)."
            },
            "relationship_id": {
              "type": "string",
              "description": "Relationship followed to reach table_occurrence. The same two tables can be joined more than once, so the occurrence alone does not identify the join."
            },
            "field_name": { "type": "string" },
            "control_style": {
              "type": "string",
              "enum": ["edit_box", "drop_down_list", "pop_up_menu", "checkbox_set", "radio_button_set", "drop_down_calendar"]
            },
            "value_list_id": { "type": "string" },
            "allow_browse_entry": { "type": "boolean", "default": true },
            "allow_find_entry": { "type": "boolean", "default": true }
          }
        },
        "portal_config": {
          "type": "object",
          "description": "Objects of type 'portal': the related records the rows show (#36).",
          "properties": {
            "relationship_id": { "type": "string" },
            "occurrence": {
              "type": "string",
              "description": "Occurrence whose records the rows show, by name. It tells the two ends apart when a relationship joins a table to itself."
            },
            "initial_row": { "type": "integer", "default": 1 },
            "row_count": { "type": "integer", "default": 5 },
            "row_height": { "type": "number" },
            "show_scroll_bar": { "type": "boolean", "default": true },
            "allow_creation": { "type": "boolean", "default": false },
            "allow_deletion": { "type": "boolean", "default": false },
            "sort": {
              "type": "string",
              "description": "Row order, as the data API takes it: 'last_name,-fee_paid'. Empty uses the relationship's own sort."
            }
          }
        },
        "chart_config": {
          "type": "object",
          "description": "Objects of type 'chart': what it draws (#37).",
          "properties": {
            "chart_type": {
              "type": "string",
              "enum": ["column", "bar", "line", "area", "pie", "scatter"],
              "default": "column"
            },
            "title": { "type": "string" },
            "category_field": {
              "type": "string",
              "description": "Grouped charts: the field whose values are the categories. Scatter: the number field along the bottom."
            },
            "series": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "field": {
                    "type": "string",
                    "description": "Grouped charts: a summary field. Scatter: the number field up the side."
                  },
                  "label": { "type": "string" },
                  "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
                },
                "required": ["field"]
              }
            },
            "show_values": { "type": "boolean", "default": true },
            "show_legend": { "type": "boolean", "default": true },
            "show_percentages": { "type": "boolean", "default": false }
          }
        },
        "style": {
          "type": "object",
          "properties": {
            "fill_color": { "type": "string" },
            "border_color": {
              "type": "string",
              "description": "Line color: border of shapes and fields, color of line objects."
            },
            "border_width": { "type": "number", "description": "Line width in points; 0 draws no border." },
            "corner_radius": { "type": "number" },
            "font_family": { "type": "string" },
            "font_size": { "type": "number" },
            "font_weight": { "type": "string" },
            "text_color": { "type": "string" },
            "text_align": { "type": "string", "enum": ["left", "center", "right", "justify"] }
          }
        }
      }
    }
  }
}
