# File4Base Docker Compose configuration.
# Copy this file to `.env` (ignored by git) and adjust the values.
# Without a `.env` file the stack starts with development defaults.

# --- Docker images -----------------------------------------------------------
# Docker Hub namespace and tag of the file4base-api / file4base-web images.
# The tag defaults to the application version (root `VERSION` file).
# FILE4BASE_REGISTRY=cloudresources
# FILE4BASE_VERSION=0.9.1

# --- Database engine credentials -------------------------------------------
# Password of the `file4base` PostgreSQL role. It is embedded in DATABASE_URL,
# so percent-encode special characters (e.g. `@` -> `%40`).
# It only takes effect when PostgreSQL initializes an empty data volume.
POSTGRES_PASSWORD=change-me

# Only used with `docker compose --profile mariadb up`
MARIADB_PASSWORD=change-me
MARIADB_ROOT_PASSWORD=change-me-too

# Interface the database ports (5432 / 3306) are published on.
# 127.0.0.1 keeps them reachable from this machine only.
DB_BIND_ADDRESS=127.0.0.1

# --- API server --------------------------------------------------------------
# Idle lifetime of a signed-in session (Go duration: 30m, 12h, ...)
SESSION_TTL=12h

# Browser origins allowed to call the API directly (comma-separated), or * for any.
# The bundled web client is served by Nginx on the same origin and does not need this.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Reverse-proxy networks whose X-Forwarded-For / X-Real-IP headers are trusted
# when recording the client address (audit log, session list, login throttle).
# Comma-separated IPs and CIDR ranges. Empty (default) trusts no proxy, so those
# headers are ignored and the direct TCP peer address is used — a client cannot
# then forge the address attributed to it. Set this only to the address(es) of a
# reverse proxy you actually run in front of file4base-api. When the bundled
# file4base-web (Nginx) proxies the API, trust the compose network, e.g.:
# FILE4BASE_TRUSTED_PROXIES=172.16.0.0/12,127.0.0.1,::1

# true  -> anyone who can reach the server can create a database (desktop "New Database" flow)
# false -> only a signed-in owner can create databases (recommended on shared servers)
ALLOW_PUBLIC_DATABASE_CREATION=true

# Database whose owners are the server administrators: only they can use the
# server-wide Server Tools (containers, TLS, every session, audit log,
# schedules, notifications, telemetry). Empty (default) disables those tools
# unless a super-owner exists (see FILE4BASE_SUPER_OWNER); each database's
# owners and admins keep the backups and maintenance of their own database.
# FILE4BASE_ADMIN_DATABASE=admin

# Bootstrap super-owners. A super-owner has full, server-wide control of every
# database, independent of the database they sign in to. List them as
# "database:username" (comma-separated for several). A seeded account signs in
# as a super-owner even before a super_owner flag is stored for it, so it can
# then grant the privilege to other owners
# (PUT /api/v1/security/users/{id}/super-owner).
# FILE4BASE_SUPER_OWNER=admin:root

# HTTPS with the File4Base Local CA.
# The API creates a local certificate authority and the certificate it signs
# inside the `file4base-tls` volume, and keeps both across restarts. Download
# the authority once from Server Tools > Domain & SSL/TLS and install it on
# each machine; after that the Web Client on https://<host>:3443 is trusted,
# and every certificate the server reissues later is trusted too.
# Name the host and the LAN addresses the certificate must cover (localhost,
# 127.0.0.1, ::1 and the container names are always included):
# FILE4BASE_TLS_DOMAIN=files.example.lan
# FILE4BASE_TLS_SANS=192.168.1.40,nas.example.lan
# Redirect plain HTTP to HTTPS on the Web Client once a certificate exists.
# The redirect keeps the host and drops the port, so it fits a deployment that
# publishes 80 and 443 directly; with the default 3000/3443 mapping, open
# https://<host>:3443 instead of enabling this.
# FILE4BASE_FORCE_HTTPS=false

# Brute-force protection for sign-in and credential-based database drops.
# After this many failed password checks in a row for one
# database+username+client, that combination is locked out for the lockout
# window. 0 disables it.
# FILE4BASE_LOGIN_MAX_ATTEMPTS=10
# FILE4BASE_LOGIN_WINDOW_SECONDS=900
# FILE4BASE_LOGIN_LOCKOUT_SECONDS=900
