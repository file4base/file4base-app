# File4Base Docker Compose configuration.
# Copy this file to `.env` (ignored by git) next to docker-compose.yml. The
# stack does not start without a database password: there is no default one.
# Add a generated password to `.env` with:
#
#   echo "POSTGRES_PASSWORD=$(openssl rand -hex 32)" >> .env
#
# MariaDB stack: the same for MARIADB_PASSWORD and MARIADB_ROOT_PASSWORD.
# Keep `.env` private (chmod 600 .env) and keep a copy of it with your backups:
# the password is needed to use the existing database volume.

# --- Docker images -----------------------------------------------------------
# Docker Hub namespace and tag of the file4base-api / file4base-web images.
# The tag defaults to the application version (root `VERSION` file).
# FILE4BASE_REGISTRY=cloudresources
# FILE4BASE_VERSION=0.9.1

# --- Database engine credentials -------------------------------------------
# Required. Password of the `file4base` PostgreSQL role, e.g. the output of
# `openssl rand -hex 32`. It is embedded in the API's DATABASE_URL, so use
# letters and digits only.
# PostgreSQL only reads it when it initializes an empty data volume; changing
# it here later does not change the password stored in the volume (README,
# "Changing the database password").
# An install created by an earlier version without a `.env` uses
# `dev_password`: set POSTGRES_PASSWORD=dev_password to keep it running, then
# change it (CHANGELOG.md, Upgrade notes).
# POSTGRES_PASSWORD=

# Required with docker-compose.mariadb.yml only (same rules as above).
# MARIADB_PASSWORD=
# MARIADB_ROOT_PASSWORD=

# The database is never published on the host: only the API reaches it,
# inside the file4base-net network. See CONTRIBUTING.md for a development
# override that publishes it on 127.0.0.1.

# --- API server --------------------------------------------------------------
# Idle lifetime of a signed-in session (Go duration: 30m, 12h, ...)
SESSION_TTL=12h

# Other web origins allowed to call the API from a browser, comma-separated
# scheme://host:port (e.g. https://intranet.example.lan). Empty (default): no
# other origin. The bundled Web Client calls the API on its own origin through
# its Nginx and needs no entry; the desktop app is not a browser and needs none
# either. `*` allows every web site and is not recommended.
# CORS_ALLOWED_ORIGINS=

# Reverse-proxy networks whose X-Forwarded-For / X-Real-IP headers are trusted
# when recording the client address (audit log, session list, login throttle).
# Comma-separated IPs and CIDR ranges. Empty (default) trusts no proxy, so those
# headers are ignored and the direct TCP peer address is used — a client cannot
# then forge the address attributed to it. Set this only to the address(es) of a
# reverse proxy you actually run in front of file4base-api. The Web Client
# reaches the API through the bundled file4base-web (Nginx), so without this the
# API records Nginx's address for every browser and the login throttle counts
# them together. To use the browser's address, trust only the subnet of the
# compose network, not a broad private range (a LAN client in that range that
# reaches port 8080 directly could then choose the address recorded for it):
#   docker network inspect file4base-net -f '{{range .IPAM.Config}}{{.Subnet}} {{end}}'
# FILE4BASE_TRUSTED_PROXIES=<that subnet>, e.g. 172.18.0.0/16

# Off by default: only a signed-in owner can create databases.
# true lets anyone who can reach the server create a database and become its
# owner. Set it only to create the first solution of a new server, then remove
# it and run `docker compose up -d` again (README, "First solution").
# ALLOW_PUBLIC_DATABASE_CREATION=true

# Deprecated, transitional: server accounts (#185) will replace it.
# Database whose owners are the server administrators: only they can use the
# server-wide Server Tools (containers, TLS, every session, audit log,
# schedules, notifications, telemetry). Empty (default) disables those tools
# unless a super-owner exists (see FILE4BASE_SUPER_OWNER); each database's
# owners and admins keep the backups and maintenance of their own database.
# FILE4BASE_ADMIN_DATABASE=admin

# Bootstrap super-owners. A super-owner has full, server-wide control of every
# database, independent of the database they sign in to. List them as
# "database:username" (comma-separated for several). A seeded account signs in
# as a super-owner even before a super_owner flag is stored for it, so it can
# then grant the privilege to other owners
# (PUT /api/v1/security/users/{id}/super-owner).
# FILE4BASE_SUPER_OWNER=admin:root

# Passwords of the SMTP accounts the Send Mail script step sends through.
# A profile (Server Tools > Send Mail) names the variable, never the password;
# the name must start with FILE4BASE_SMTP_. Pass each one to the API container
# (docker-compose.yml passes FILE4BASE_SMTP_PASSWORD).
# FILE4BASE_SMTP_PASSWORD=

# HTTPS with the File4Base Local CA.
# The API creates a local certificate authority and the certificate it signs
# inside the `file4base-tls` volume, and keeps both across restarts. Download
# the authority once from Server Tools > Domain & SSL/TLS and install it on
# each machine; after that the Web Client on https://<host>:3443 is trusted,
# and every certificate the server reissues later is trusted too.
# Name the host and the LAN addresses the certificate must cover (localhost,
# 127.0.0.1, ::1 and the container names are always included):
# FILE4BASE_TLS_DOMAIN=files.example.lan
# FILE4BASE_TLS_SANS=192.168.1.40,nas.example.lan
# Redirect plain HTTP to HTTPS on the Web Client once a certificate exists.
# The redirect keeps the host and drops the port, so it fits a deployment that
# publishes 80 and 443 directly; with the default 3000/3443 mapping, open
# https://<host>:3443 instead of enabling this.
# FILE4BASE_FORCE_HTTPS=false

# Brute-force protection for sign-in and credential-based database drops.
# After this many failed password checks in a row for one
# database+username+client, that combination is locked out for the lockout
# window. 0 disables it.
# FILE4BASE_LOGIN_MAX_ATTEMPTS=10
# FILE4BASE_LOGIN_WINDOW_SECONDS=900
# FILE4BASE_LOGIN_LOCKOUT_SECONDS=900
