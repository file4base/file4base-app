          "200": {
            "description": "Session details"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/api/v1/databases": {
      "get": {
        "tags": [
          "Solutions & Backup"
        ],
        "summary": "List solution databases (public: used by the sign-in screen)",
        "security": [],
        "responses": {
          "200": {
            "description": "Databases on the server",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatabaseList"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Solutions & Backup"
        ],
        "summary": "Create a database and its first owner account",
        "description": "Public while ALLOW_PUBLIC_DATABASE_CREATION=true (default); otherwise requires an owner session. Never modifies an existing database.",
        "security": [
          {},
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateDatabaseRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Database created"
          },
          "409": {
            "description": "A database with that name already exists"
          },
          "422": {
            "description": "Missing name or owner credentials"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/api/v1/databases/{name}": {
      "delete": {
        "tags": [
          "Solutions & Backup"
        ],
        "summary": "Drop a database",
        "description": "Requires an owner session on that database, or the credentials of one of its owners in the request body.",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OwnerCredentials"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Database dropped"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "description": "Database not found"
          }
        }
      }
    },
    "/api/v1/security/users": {
      "get": {
        "tags": [
          "Security & Users"
        ],
        "summary": "List Users",
        "responses": {
          "200": {
            "description": "List of system users",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/User"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      },
      "post": {
        "tags": [
          "Security & Users"
        ],
        "summary": "Create User",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUserRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/api/v1/security/permissions": {
      "get": {
        "tags": [
          "Security & Users"
        ],
        "summary": "List Layout Permissions",
        "responses": {
          "200": {
            "description": "Permissions list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Permission"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      },
      "post": {
        "tags": [
          "Security & Users"
        ],
        "summary": "Set User Layout Permission",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Permission"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Permission updated"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/api/v1/solutions/save-copy": {
      "post": {
        "tags": [
          "Solutions & Backup"
        ],
        "summary": "Save Copy as MessagePack Solution Archive",
        "description": "Generates a complete standalone solution snapshot including tables, columns, occurrences, relationships, layouts, users, permissions, and data records.",
        "responses": {
          "200": {
            "description": "Binary MessagePack (.f4p) solution file",
            "content": {
              "application/x-msgpack": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/api/v1/solutions/load-copy": {
      "post": {
        "tags": [
          "Solutions & Backup"
        ],
        "summary": "Load MessagePack Solution Archive",
        "description": "Restores or imports a full database solution package into the active catalog.",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-msgpack": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Solution loaded successfully"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "TableMetadata": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "example": "customers"
          },
          "display_name": {
            "type": "string",
            "example": "Customers"
          },
          "description": {
            "type": "string"
          },
          "columns": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ColumnMetadata"
            }
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ColumnMetadata": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "table_id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "example": "phone_number"
          },
          "display_name": {
            "type": "string",
            "example": "Phone Number"
          },
          "field_type": {
            "type": "string",
            "enum": [
              "TEXT",
              "NUMBER",
              "DATE",
              "TIMESTAMP",
              "BOOLEAN",
              "CONTAINER",
              "CALCULATION",
              "SUMMARY"
            ]
          },
          "is_nullable": {
            "type": "boolean"
          },
          "is_primary_key": {
            "type": "boolean"
          },
          "default_value": {
            "type": "string"
          },
          "calculation_formula": {
            "type": "string"
          },
          "validation_rules": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreateTableRequest": {
        "type": "object",
        "required": [
          "display_name"
        ],
        "properties": {
          "display_name": {
            "type": "string",
            "example": "Invoices"
          },
          "custom_name": {
            "type": "string",
            "example": "invoices"
          }
        }
      },
      "AddColumnRequest": {
        "type": "object",
        "required": [
          "name",
          "display_name",
          "field_type"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "total_amount"
          },
          "display_name": {
            "type": "string",
            "example": "Total Amount"
          },
          "field_type": {
            "type": "string",
            "example": "NUMBER"
          },
          "is_nullable": {
            "type": "boolean",
            "default": true
          },
          "default_value": {
            "type": "string"
          },
          "calculation_formula": {
            "type": "string"
          },
          "validation_rules": {
            "type": "string"
          }
        }
      },
      "UpdateColumnRequest": {
        "type": "object",
        "required": [
          "display_name"
        ],
        "properties": {
          "display_name": {
            "type": "string",
            "example": "Invoice Total"
          },
          "default_value": {
            "type": "string",
            "description": "Auto-enter and storage configuration JSON"
          },
          "calculation_formula": {
            "type": "string",
            "description": "Formula expression or summary operation JSON"
          },
          "validation_rules": {
            "type": "string",
            "description": "Validation constraints JSON"
          }
        }
      },
      "TableOccurrence": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "base_table_id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "example": "Customers_Active"
          },
          "x_pos": {
            "type": "number",
            "example": 100
          },
          "y_pos": {
            "type": "number",
            "example": 120
          }
        }
      },
      "Relationship": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "left_occurrence_id": {
            "type": "string"
          },
          "left_column_id": {
            "type": "string"
          },
          "right_occurrence_id": {
            "type": "string"
          },
          "right_column_id": {
            "type": "string"
          },
          "operator": {
            "type": "string",
            "default": "="
          },
          "allow_creation": {
            "type": "boolean",
            "default": false
          },
          "cascade_delete": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "Layout": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "example": "Customer Details"
          },
          "table_occurrence_id": {
            "type": "string"
          },
          "definition": {
            "type": "object",
            "description": "Deterministic JSON layout schema definition"
          }
        }
      },
      "FindRequest": {
        "type": "object",
        "required": [
          "criteria"
        ],
        "properties": {
          "criteria": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "omit": {
            "type": "boolean",
            "default": false
          },
          "limit": {
            "type": "integer",
            "default": 100
          },
          "offset": {
            "type": "integer",
            "default": 0
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "database",
          "username",
          "password"
        ],
        "properties": {
          "database": {
            "type": "string",
            "example": "invoices_db"
          },
          "username": {
            "type": "string",
            "example": "alice"
          },
          "password": {
            "type": "string",
            "format": "password"
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          },
          "database": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          },
          "token": {
            "type": "string",
            "description": "Session bearer token"
          },
          "token_type": {
            "type": "string",
            "example": "Bearer"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "admin",
              "user",
              "guest"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreateUserRequest": {
        "type": "object",
        "required": [
          "username",
          "password",
          "role"
        ],
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "default": "user"
          }
        }
      },
      "Permission": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "user_id": {
            "type": "string"
          },
          "layout_id": {
            "type": "string"
          },
          "access_level": {
            "type": "string",
            "enum": [
              "no_access",
              "read_only",
              "read_write"
            ]
          }
        }
      },
      "HealthDiagnostic": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "pass"
          },
          "version": {
            "type": "string",
            "example": "0.4.7"
          },
          "release_id": {
            "type": "string",
            "example": "file4base-api-v0.4.7"
          },
          "uptime_seconds": {
            "type": "integer"
          },
          "checks": {
            "type": "object"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "description": "RFC 9457 Problem Details for HTTP APIs",
        "properties": {
          "type": {
            "type": "string",
            "example": "about:blank"
          },
          "title": {
            "type": "string",
            "example": "Bad Request"
          },
          "status": {
            "type": "integer",
            "example": 400
          },
          "detail": {
            "type": "string",
            "example": "Invalid column format"
          },
          "instance": {
            "type": "string",
            "example": "/api/v1/schemas/tables"
          }
        }
      },
      "CreateDatabaseRequest": {
        "type": "object",
        "required": [
          "database",
          "user",
          "password"
        ],
        "properties": {
          "database": {
            "type": "string",
            "example": "invoices_db"
          },
          "user": {
            "type": "string",
            "description": "Username of the first owner account"
          },
          "password": {
            "type": "string",
            "format": "password",
            "description": "Password of the first owner account"
          }
        }
      },
      "DatabaseList": {
        "type": "object",
        "properties": {
          "databases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "active": {
            "type": "string",
            "description": "Database of the caller's session; empty when signed out"
          }
        }
      },
      "OwnerCredentials": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "format": "password"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Opaque session token returned by POST /api/v1/auth/login. Bound to one user and one database; expires after a period of inactivity (SESSION_TTL, default 12h)."
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Missing, invalid or expired session token",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      },
      "Forbidden": {
        "description": "The session's role or layout permissions do not allow this operation",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]
}
