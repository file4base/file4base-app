                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      },
      "post": {
        "tags": [
          "Schemas & DDL"
        ],
        "summary": "Create Table Occurrence",
        "requestBody": {
          "required": true,
