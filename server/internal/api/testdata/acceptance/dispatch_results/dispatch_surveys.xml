<?xml version="1.0" encoding="UTF-8"?>
<!--
  Dispatch :: Surveys records, as a FileMaker FMPXMLRESULT export writes them.
  Deterministic synthetic data: precise decimals, Unicode, untrimmed text and
  a blank value, so data fidelity is measurable rather than approximate.
-->
<FMPXMLRESULT xmlns="http://www.filemaker.com/fmpxmlresult">
