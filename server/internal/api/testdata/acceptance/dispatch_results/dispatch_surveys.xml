  <METADATA>
    <FIELD EMPTYOK="NO" MAXREPEAT="1" NAME="_Code" TYPE="TEXT"/>
    <FIELD EMPTYOK="YES" MAXREPEAT="1" NAME="Title" TYPE="TEXT"/>
    <FIELD EMPTYOK="YES" MAXREPEAT="1" NAME="Score" TYPE="NUMBER"/>
    <FIELD EMPTYOK="YES" MAXREPEAT="1" NAME="SessionFilter" TYPE="TEXT"/>
    <FIELD EMPTYOK="YES" MAXREPEAT="5" NAME="Tags" TYPE="TEXT"/>
  </METADATA>
  <RESULTSET FOUND="3">
    <ROW MODID="4" RECORDID="1">
      <COL><DATA>SV-1</DATA></COL>
      <COL><DATA>Encuesta ñ – 日本</DATA></COL>
